# Copy to .env.local. With no Supabase variables the app uses fictional demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY: never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Generate at least 32 random bytes (for example: openssl rand -hex 32).
SURVEY_COOKIE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Credentials for a dedicated test project only; optional database integration tests.
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
